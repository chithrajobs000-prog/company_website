# ============================================================
#  CHITRA JOBS — Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# Server port (default: 3000)
PORT=3000

# ─── Telegram Bot Configuration ───────────────────────────
# Step 1: Message @BotFather on Telegram
# Step 2: Send /newbot → it gives you a TOKEN like: 123456789:ABCDefghIJKlmNoPQRsTUVwxyZ
# Step 3: Paste the token below

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ─── Your Telegram Chat ID ────────────────────────────────
# Step 1: Message your bot (@Chitra_jobs_bot) → send /start
# Step 2: Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# Step 3: Find "chat":{"id": XXXXXXXXX} — that is your Chat ID
# Step 4: Paste the numeric ID below

TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ─── Optional: If you want to send to a Telegram Channel ──
# Add bot as admin to your channel, then use: @YourChannelName
# TELEGRAM_CHAT_ID=@YourChannelName
